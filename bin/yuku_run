parser.add_argument('--scienti_entity_publication_events_audit_name')
parser.add_argument('--audit_scienti_auxiliary_semantics', action='store_true',
                    help='Run a specialized semantic audit for works, patents or events')
parser.add_argument('--scienti_auxiliary_audit_name', default='scienti_auxiliary_semantic_audit')
parser.add_argument('--scienti_auxiliary_audit_entity', choices=('works', 'patents', 'events'))
parser.add_argument('--scienti_auxiliary_audit_collection')
parser.add_argument('--scienti_auxiliary_audit_entity_run_name', default='scienti_entities_v1')
parser.add_argument('--scienti_auxiliary_audit_progress_every', type=int, default=10000)
parser.add_argument('--scienti_auxiliary_audit_batch_size', type=int, default=2000)
parser.add_argument('--scienti_auxiliary_audit_example_limit', type=int, default=100)

if __name__ == '__main__':
    args = parser.parse_args()
    yuku = Yuku(args.mongo_dbname, args.mongo_dburi,
                args.socrata_endpoint, args.delay)
    
    if args.drop_mongodb:
        MongoClient(args.mongo_dburi).drop_database(args.mongo_dbname)
    if args.scienti_pipeline_status:
        print(json.dumps(
            yuku.scienti_pipeline_status(args.scienti_pipeline_status),
            ensure_ascii=False,
            indent=2,
            default=str,
        ))
    if args.run_scienti_pipeline:
        print(json.dumps(
            yuku.run_scienti_pipeline(
                args.run_scienti_pipeline,
                from_stage=args.scienti_pipeline_from_stage,
                to_stage=args.scienti_pipeline_to_stage,
                dry_run=args.scienti_pipeline_dry_run,
            ),
            ensure_ascii=False,
            indent=2,
            default=str,
        ))
    if args.search is not None:
        yuku.search(args.search, args.search_limit)

    if args.download_cvlac is not None:
        yuku.download_cvlac_data(args.download_cvlac)

    if args.download_gruplac_production is not None:
        yuku.download_gruplac_production(args.download_gruplac_production)

    if args.download_gruplac_groups is not None:
        yuku.download_gruplac_groups(args.download_gruplac_groups)

    if args.download_cvlac_profiles:
        if not args.allow_legacy_cvlac_scraper:
            parser.error(
                '--download_cvlac_profiles is deprecated; use the Scienti '
